# Postgres connection string used by the server (see src/env.ts).
DATABASE_URL=postgres://trampa:trampa@localhost:5432/trampa

# HTTP port the API listens on.
PORT=8787

# Optional. If set, the daily config is generated by the Anthropic Messages API.
# If empty, the server falls back to the deterministic defaultConfig and never fails.
ANTHROPIC_API_KEY=

# Model used for the daily config generation.
LLM_MODEL=claude-sonnet-5
